# Copy to /etc/null-set/stem-server.env, then: chown root:root and chmod 600 it.
# Generate the token with: openssl rand -hex 32   (at least 32 chars; same value in the phone's Settings)
STEM_SERVER_TOKEN=
# Behind Caddy (TLS on the public address, /stems/* routed here with the prefix stripped): loopback.
# Testing only: CT116's own address 10.0.0.116 over Tailscale (plain HTTP, debug phone builds only).
STEM_SERVER_HOST=127.0.0.1
STEM_PORT=47830
# VRAM cap for one split (GiB). The 3090 is shared: leave room for the other services.
STEM_SERVER_VRAM_GB=6
# Optional: model name (default htdemucs_ft), device (default cuda -> mps -> cpu), upload cap.
#STEM_SERVER_MODEL=htdemucs_ft
#STEM_SERVER_DEVICE=cuda
#STEM_SERVER_MAX_UPLOAD_MB=200
